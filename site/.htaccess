# Устанавливаем кодировку UTF-8 для всех текстовых файлов по умолчанию
AddDefaultCharset UTF-8

# ========== GZIP СЖАТИЕ ==========
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
    AddOutputFilterByType DEFLATE application/json application/xml text/xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE application/font-woff application/font-woff2
</IfModule>

# ========== КЕШИРОВАНИЕ ==========
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML — не кешируем (чтобы обновления были видны сразу)
    ExpiresByType text/html "access plus 0 seconds"

    # CSS и JS — кеш 1 год (при изменении добавьте ?v=2 в URL)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    # Изображения — кеш 1 год
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Видео — кеш 1 год
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType video/webm "access plus 1 year"

    # Шрифты — кеш 1 год
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# ========== ЗАГОЛОВКИ КЕША (fallback) ==========
<IfModule mod_headers.c>
    <FilesMatch "\.(html|htm)$">
        Header set Content-Type "text/html; charset=utf-8"
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.css$">
        Header set Content-Type "text/css; charset=utf-8"
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.js$">
        Header set Content-Type "application/javascript; charset=utf-8"
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(png|jpg|jpeg|gif|webp|svg|ico|mp4|webm|woff|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    Header set Vary "Accept-Encoding"
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>


# Старые пути картинок (до реструктуризации)
RewriteRule ^assets/(?!css/|js/|img/|media/)(.+)$ assets/img/$1 [L]
# ========== СТАРЫЕ ПУТИ CSS/JS (обратная совместимость) ==========
RewriteRule ^style\.css$ assets/css/style.css [L]
RewriteRule ^services\.css$ assets/css/services.css [L]
RewriteRule ^equipment\.css$ assets/css/equipment.css [L]
RewriteRule ^script\.js$ assets/js/script.js [L]
RewriteRule ^services\.js$ assets/js/services.js [L]
RewriteRule ^equipment\.js$ assets/js/equipment.js [L]
RewriteRule ^tracker\.js$ assets/js/tracker.js [L]

# ========== НАСТРОЙКИ ЧПУ ==========
# Включаем механизм перенаправления
RewriteEngine On
RewriteBase /

# Динамический sitemap
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Если запрашиваемый файл или папка реально существуют — отдаём их напрямую
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Всё остальное направляем в index.php
RewriteRule ^(.*)$ index.php?route=$1 [L,QSA]

# (Опционально) Редиректы со старых .html-адресов на новые ЧПУ
# Раскомментируйте строки ниже, когда создадите новые URL
Redirect 301 /services.html /uslugi
Redirect 301 /equipment.html /magazin
Redirect 301 /index.html /
Redirect 301 /equipment /magazin